        { "type": "lock", "offset": 42 },
        { "type": "tick_range", "from": 45, "to": 95, "step": 5 },
        { "type": "clock_set", "offset": 100 },
        { "type": "unlock", "offset": 100 }
      ],
      "expectedSessions": [
        {
          "appId": 1,
          "startUtc": 1773144000,
          "endReason": "sleep"
        },
        {
          "appId": 1,
          "startUtc": 1773144100,
          "endUtc": null
        }
      ]
    },
    {
      "name": "lock-ignored-when-counting-locked",
