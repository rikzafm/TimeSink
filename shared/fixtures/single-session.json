{
  "name": "single-session-and-multi-process",
  "description": "Single process lifecycle and multiple overlapping processes coalescing into one session",
  "timeZoneId": "UTC",
  "baseTimeUtc": "2026-03-10T12:00:00Z",
  "settings": {
    "minSessionSeconds": 15,
    "pauseOnSleep": true,
    "countWhenLocked": true
  },
  "apps": [
    {
      "id": 1,
      "name": "Notepad",
      "path": "c:\\windows\\notepad.exe",
      "bundleId": "com.microsoft.Notepad",
      "addedUtc": 0
    }
  ],
  "cases": [
    {
      "name": "single-session-open-and-close",
      "description": "Session opens when process appears and closes with exact duration on exit",
      "events": [
        { "type": "proc_start", "pid": 10, "appId": 1, "procStartOffset": 20, "offset": 20 },
        { "type": "tick_range", "from": 0, "to": 60, "step": 5 },
        { "type": "proc_exit", "pid": 10, "offset": 65 },
        { "type": "tick", "offset": 65 }
      ],
      "expectedSessions": [
        {
          "appId": 1,
          "startUtc": 1773144020,
          "endUtc": 1773144065,
          "endReason": "exit",
          "pid": 10,
          "procStartUtc": 1773144020
        }
      ],
      "expectedDailyUsage": {
        "2026-03-10": 45
      }
    },
    {
      "name": "multi-process-coalescing",
      "description": "Several processes of one app are one session that outlives the first process",
      "events": [
        { "type": "proc_start", "pid": 1, "appId": 1, "procStartOffset": 0, "offset": 0 },
        { "type": "proc_start", "pid": 2, "appId": 1, "procStartOffset": 10, "offset": 10 },
        { "type": "proc_start", "pid": 3, "appId": 1, "procStartOffset": 15, "offset": 15 },
        { "type": "tick_range", "from": 0, "to": 30, "step": 5 },
        { "type": "proc_exit", "pid": 1, "offset": 35 },
        { "type": "tick_range", "from": 35, "to": 60, "step": 5 },
        { "type": "proc_exit", "pid": 2, "offset": 65 },
        { "type": "proc_exit", "pid": 3, "offset": 65 },
        { "type": "tick", "offset": 65 }
      ],
      "expectedSessions": [
        {
          "appId": 1,
          "startUtc": 1773144000,
          "endUtc": 1773144065
        }
      ],
      "expectedDailyUsage": {
        "2026-03-10": 65
      }
    }
  ]
}
