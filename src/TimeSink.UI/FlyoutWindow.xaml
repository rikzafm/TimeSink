<Window x:Class="TimeSink.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Width="420" Height="620"
        Background="{DynamicResource Brush.Surface}" Title="{DynamicResource Str.AppName}">
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{DynamicResource Thickness.Border}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: app dot, wordmark, settings -->
            <Grid Grid.Row="0" Margin="16,12,10,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource Wordmark}" Text="{DynamicResource Str.AppName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="GamesButton" Width="34" Height="34" Margin="0,0,2,0" AutomationProperties.Name="Games only" ToolTip="{DynamicResource Str.GamesOnly}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Box" CornerRadius="{DynamicResource CornerRadius.Small}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M6 11h4M8 9v4M15 12h.01M18 10h.01M17.3 5H6.7a4 4 0 0 0-3.9 3.2l-1.5 7A3 3 0 0 0 4.2 19c.9 0 1.6-.5 2.1-1.2l1.1-1.8h9.2l1.1 1.8c.5.7 1.2 1.2 2.1 1.2a3 3 0 0 0 2.9-3.8l-1.5-7A4 4 0 0 0 17.3 5z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Tag" Value="on">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="SettingsButton" ToolTip="{DynamicResource Str.Settings}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab bar -->
            <Border x:Name="TabStrip" Grid.Row="1" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,0,1" Margin="8,0">
                <UniformGrid x:Name="TabBar" Rows="1">
                    <RadioButton Style="{StaticResource TabButton}" Tag="Today" Content="{DynamicResource Str.TabToday}"/>
                    <RadioButton Style="{StaticResource TabButton}" Tag="Week" Content="{DynamicResource Str.TabWeek}"/>
                    <RadioButton Style="{StaticResource TabButton}" Tag="Month" Content="{DynamicResource Str.TabMonth}"/>
                    <RadioButton Style="{StaticResource TabButton}" Tag="Year" Content="{DynamicResource Str.TabYear}"/>
                    <RadioButton Style="{StaticResource TabButton}" Tag="All" Content="{DynamicResource Str.TabAll}"/>
                </UniformGrid>
            </Border>

            <!-- Tab body: built lazily, one tab at a time -->
            <ContentPresenter x:Name="Body" Grid.Row="2"/>

            <!-- Footer -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,1,0,0" Padding="10,6">
                <Button x:Name="AddAppButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Foreground="{DynamicResource Brush.Accent}" Content="{DynamicResource Str.AddApp}"/>
            </Border>

            <!-- Full-flyout overlay screens (Add app) -->
            <ContentPresenter x:Name="Overlay" Grid.RowSpan="4"/>
        </Grid>
    </Border>
</Window>
