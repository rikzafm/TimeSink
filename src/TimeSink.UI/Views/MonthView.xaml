<UserControl x:Class="TimeSink.UI.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimeSink.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Small}"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Numbers}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="{DynamicResource Thickness.Border}" CornerRadius="{DynamicResource CornerRadius.Small}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <StackPanel Margin="16,6,16,6">
                <Grid Margin="0,0,0,6">
                    <Button x:Name="Prev" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Content="‹"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="MonthName" HorizontalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" FontFamily="{DynamicResource FontFamily.Ui}"
                                   FontSize="{DynamicResource Double.FontSize.Title}"/>
                        <TextBlock x:Name="Span" Style="{StaticResource Small}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="Next" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Content="›"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.MonthCombined}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Total" Foreground="{DynamicResource Brush.Accent}"
                                       FontFamily="{DynamicResource FontFamily.Numbers}" FontWeight="Bold"
                                       FontSize="{DynamicResource Double.FontSize.Display}"/>
                            <Border x:Name="DeltaPill" Margin="8,0,0,5" VerticalAlignment="Bottom" Padding="8,2"
                                    CornerRadius="999" BorderThickness="{DynamicResource Thickness.Border}">
                                <TextBlock x:Name="Delta" Style="{StaticResource Number}" FontSize="{DynamicResource Double.FontSize.Small}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock x:Name="Avg" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="Best" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <c:CalendarHeat x:Name="Calendar"
                                TextBrush="{DynamicResource Brush.Text}" SoftBrush="{DynamicResource Brush.TextSoft}"
                                MutedBrush="{DynamicResource Brush.TextMuted}" OnHeatBrush="{DynamicResource Brush.OnAccent}"
                                FutureBorderBrush="{DynamicResource Brush.Border}"
                                LabelFontFamily="{DynamicResource FontFamily.Numbers}"
                                LabelFontSize="{DynamicResource Double.FontSize.Small}"/>
                <StackPanel x:Name="Legend" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                <Border x:Name="DayPanel" Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{DynamicResource Thickness.Border}"
                        CornerRadius="{DynamicResource CornerRadius.Medium}">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="SelDate" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"
                                       FontFamily="{DynamicResource FontFamily.Ui}" FontSize="{DynamicResource Double.FontSize.Body}"/>
                            <TextBlock x:Name="SelTotal" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"
                                       FontFamily="{DynamicResource FontFamily.Numbers}" FontSize="{DynamicResource Double.FontSize.Body}"/>
                        </Grid>
                        <c:StackedBar x:Name="SelBar" Margin="0,6,0,0" TrackBrush="{DynamicResource Brush.BorderSoft}"/>
                        <TextBlock x:Name="SelNote" Style="{StaticResource Small}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="TopApps" Margin="0,6,0,0"/>
                <TextBlock x:Name="Empty" Style="{StaticResource Small}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12"
                           Text="{DynamicResource Str.MonthEmpty}" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="ExportButton" Grid.Row="1" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,10,2"/>
    </Grid>
</UserControl>
