<UserControl x:Class="TimeSink.UI.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimeSink.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="Soft" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Body}"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Small}"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Numbers}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Thickness.Border}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel Margin="16,10,16,12">
            <c:DayNav x:Name="Nav"/>

            <Grid Margin="0,2,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalMain" Foreground="{DynamicResource Brush.Accent}"
                               FontFamily="{DynamicResource FontFamily.Numbers}" FontWeight="Bold"
                               FontSize="{DynamicResource Double.FontSize.Display}"/>
                    <TextBlock x:Name="TotalSeconds" Style="{StaticResource Small}" Margin="4,0,0,6" VerticalAlignment="Bottom"
                               FontFamily="{DynamicResource FontFamily.Numbers}" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
                <Border x:Name="RunningPill" HorizontalAlignment="Right" VerticalAlignment="Center" Height="24"
                        CornerRadius="12" Padding="10,0"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderSoft}"
                        BorderThickness="{DynamicResource Thickness.Border}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Width="13" Height="13" Fill="{DynamicResource Brush.Accent}" Opacity="0.25"/>
                            <Ellipse x:Name="RunningDot" Width="7" Height="7" Fill="{DynamicResource Brush.Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RunningText" Style="{StaticResource Number}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel x:Name="DeviceSummaryRow" Margin="0,2,0,8" Visibility="Collapsed"/>

            <Border x:Name="ChartCard"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,14,12,10"
                    Margin="0,4,0,8">
                <StackPanel>
                    <c:HourlyBars x:Name="Chart" Height="62" Margin="0,0,0,2"
                                  TextElement.FontFamily="{DynamicResource FontFamily.Numbers}"
                                  LabelFontFamily="{DynamicResource FontFamily.Numbers}"
                                  LabelFontSize="10"
                                  BarBrush="{DynamicResource Brush.Heat2}" CurrentBrush="{DynamicResource Brush.Accent}"
                                  Heat0="{DynamicResource Brush.Heat0}" Heat1="{DynamicResource Brush.Heat1}"
                                  Heat2="{DynamicResource Brush.Heat2}" Heat3="{DynamicResource Brush.Heat3}"
                                  DeviceABrush="{DynamicResource Brush.DeviceA}" DeviceBBrush="{DynamicResource Brush.DeviceB}"
                                  Cursor="Hand"
                                  MutedBrush="{DynamicResource Brush.TextMuted}" LabelTextBrush="{DynamicResource Brush.OnAccent}"/>
                    <Grid x:Name="Axis" Margin="0,0,0,8" Height="16"/>
                    <WrapPanel x:Name="LegendPanel" Margin="0">
                        <StackPanel x:Name="LegendAppsOpen" Orientation="Horizontal" Margin="0,0,14,0">
                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Small}" FontSize="10" Text="{DynamicResource Str.LegendAppsOpen}"/>
                        </StackPanel>
                        <StackPanel x:Name="LegendDeviceA" Orientation="Horizontal" Margin="0,0,9,0" Visibility="Collapsed">
                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Heat3}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LegendDeviceAText" Style="{StaticResource Small}" FontSize="10"/>
                        </StackPanel>
                        <StackPanel x:Name="LegendDeviceB" Orientation="Horizontal" Margin="0,0,9,0" Visibility="Collapsed">
                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.DeviceB}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LegendDeviceBText" Style="{StaticResource Small}" FontSize="10"/>
                        </StackPanel>
                        <StackPanel x:Name="LegendOverlap" Orientation="Horizontal" Margin="0,0,9,0" Visibility="Collapsed">
                            <Grid Width="12" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Rectangle Width="7" Height="8" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.Heat3}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Rectangle Width="7" Height="5" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.DeviceB}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Small}" FontSize="10" Text="{DynamicResource Str.LegendOverlapping}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <DrawingBrush Viewport="0,0,3,3" ViewportUnits="Absolute" TileMode="Tile">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="{DynamicResource Brush.TextMuted}" Thickness="1.5"/>
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <LineGeometry StartPoint="0,3" EndPoint="3,0"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="LegendAsleepText" Style="{StaticResource Small}" FontSize="10" Text="{DynamicResource Str.LegendAsleep}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <c:DetailPanel x:Name="Panel" Margin="0,0,0,8"/>

            <TextBlock x:Name="EarlyHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="{DynamicResource Str.TodayEarlyHint}" Visibility="Collapsed"/>

            <UniformGrid x:Name="StatTilesGrid" Rows="1" Margin="0,0,0,10">
                <Border x:Name="TileFirstBox" Style="{StaticResource Tile}" Margin="0,0,4,0" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.TileFirstApp}"/>
                        <TextBlock x:Name="TileFirst" Style="{StaticResource Number}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TileLongestBox" Style="{StaticResource Tile}" Margin="2,0" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.TileLongest}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <ContentControl x:Name="TileLongestIcon" Margin="0,0,6,0" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock x:Name="TileLongest" Style="{StaticResource Number}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="TileVsBox" Style="{StaticResource Tile}" Margin="4,0,0,0" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.TileVsYesterday}"/>
                        <TextBlock x:Name="TileVs" Style="{StaticResource Number}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="Empty" Style="{StaticResource Small}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,16"
                       Text="{DynamicResource Str.TodayEmpty}" Visibility="Collapsed"/>
            <StackPanel x:Name="UntrackedHost"/>
            <Grid x:Name="TrackedHeader" Margin="0,0,0,4" Visibility="Collapsed">
                <TextBlock x:Name="TrackedLabel" Style="{StaticResource Small}" HorizontalAlignment="Left" Text="{DynamicResource Str.TodayTrackedHeader}"/>
            </Grid>
            <StackPanel x:Name="Rows"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
