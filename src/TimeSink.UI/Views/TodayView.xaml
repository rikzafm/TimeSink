<UserControl x:Class="TimeSink.UI.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimeSink.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="Soft" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Body}"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Small}"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Numbers}"/>
            <Setter Property="FontSize" Value="{DynamicResource Double.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Thickness.Border}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Medium}"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel Margin="16,10,16,12">
            <c:DayNav x:Name="Nav"/>

            <Grid Margin="0,2,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalMain" Foreground="{DynamicResource Brush.Accent}"
                               FontFamily="{DynamicResource FontFamily.Numbers}" FontWeight="SemiBold"
                               FontSize="{DynamicResource Double.FontSize.Display}"/>
                    <TextBlock x:Name="TotalSeconds" Style="{StaticResource Small}" Margin="6,0,0,5" VerticalAlignment="Bottom"
                               FontFamily="{DynamicResource FontFamily.Numbers}" FontSize="{DynamicResource Double.FontSize.Body}"/>
                </StackPanel>
                <Border x:Name="RunningPill" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4,10,4"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="{DynamicResource Thickness.Border}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="20">
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                                 From="1" To="2.75" Duration="0:0:1.6"/>
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                                 From="1" To="2.75" Duration="0:0:1.6"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse x:Name="RunningDot" Fill="{DynamicResource Brush.Accent}"/>
                        </Grid>
                        <TextBlock x:Name="RunningText" Style="{StaticResource Number}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <c:HourlyBars x:Name="Chart" Height="104" Margin="0,0,0,4"
                          TextElement.FontFamily="{DynamicResource FontFamily.Numbers}"
                          LabelFontFamily="{DynamicResource FontFamily.Numbers}"
                          LabelFontSize="{DynamicResource Double.FontSize.Small}"
                          BarBrush="{DynamicResource Brush.Heat2}" CurrentBrush="{DynamicResource Brush.Accent}"
                          Cursor="Hand"
                          MutedBrush="{DynamicResource Brush.TextMuted}" LabelTextBrush="{DynamicResource Brush.OnAccent}"/>
            <Grid x:Name="Axis" Margin="0,0,0,6"/>
            <c:DetailPanel x:Name="Panel"/>

            <WrapPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.LegendAppsOpen}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Rectangle Width="9" Height="2" Fill="{DynamicResource Brush.TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.LegendTypical}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.LegendAsleep}"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock x:Name="EarlyHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="{DynamicResource Str.TodayEarlyHint}" Visibility="Collapsed"/>

            <UniformGrid Rows="1" Margin="0,0,0,10">
                <Border x:Name="TileFirstBox" Style="{StaticResource Tile}" Margin="0,0,4,0" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.TileFirstApp}"/>
                        <TextBlock x:Name="TileFirst" Style="{StaticResource Number}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TileLongestBox" Style="{StaticResource Tile}" Margin="2,0" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.TileLongest}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <ContentControl x:Name="TileLongestIcon" Margin="0,0,6,0" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock x:Name="TileLongest" Style="{StaticResource Number}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="TileVsBox" Style="{StaticResource Tile}" Margin="4,0,0,0" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Str.TileVsYesterday}"/>
                        <TextBlock x:Name="TileVs" Style="{StaticResource Number}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="Empty" Style="{StaticResource Small}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,16"
                       Text="{DynamicResource Str.TodayEmpty}" Visibility="Collapsed"/>
            <StackPanel x:Name="UntrackedHost"/>
            <Grid x:Name="TrackedHeader" Margin="0,0,0,4" Visibility="Collapsed">
                <TextBlock x:Name="TrackedLabel" Style="{StaticResource Small}" HorizontalAlignment="Left" Text="{DynamicResource Str.TodayTrackedHeader}"/>
                <TextBlock x:Name="CombinedText" Style="{StaticResource Small}" HorizontalAlignment="Right"
                           FontFamily="{DynamicResource FontFamily.Numbers}"/>
            </Grid>
            <StackPanel x:Name="Rows"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
